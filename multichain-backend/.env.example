# Port
PORT=3000

# ============================================================
# EVM 配置 (支持多钱包职责严格隔离)
# ============================================================
EVM_RPC_URL=https://ethereum-rpc.publicnode.com
EVM_CHAIN_ID=1
EVM_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D

# 1. 充值入金专用收款地址池 (只收不发)
EVM_DEPOSIT_WALLET_KEYS=0xDepositKey1,0xDepositKey2

# 2. 出金提现专用付款热钱包池 (只出不进，常备业务资金与Gas)
EVM_WITHDRAW_WALLET_KEYS=0xWithdrawKey1,0xWithdrawKey2

# 3. 发币专属部署钱包池 (拥有合约所有权与初始代币铸造权，严禁与出入金混用)
EVM_DEPLOYER_WALLET_KEYS=0xDeployerKey1

# ============================================================
# Solana 配置 (支持多钱包职责严格隔离)
# ============================================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RAYDIUM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8

# 1. 充值入金专用收款地址池
SOLANA_DEPOSIT_WALLET_KEYS=DepositKey1,DepositKey2

# 2. 出金提现专用付款热钱包池
SOLANA_WITHDRAW_WALLET_KEYS=WithdrawKey1,WithdrawKey2

# 3. 发币专属部署钱包池 (作为 Mint Authority & Freeze Authority)
SOLANA_DEPLOYER_WALLET_KEYS=DeployerKey1

# ============================================================
# Tron 配置 (支持多钱包职责严格隔离)
# ============================================================
TRON_FULL_HOST=https://api.trongrid.io
TRON_API_KEY=your_trongrid_api_key
TRON_SUNSWAP_ROUTER=TKzxdSv2xMmAQzfTtQBp5UBmBjZZMmsssC

# 1. 充值入金专用收款地址池
TRON_DEPOSIT_WALLET_KEYS=DepositKey1,DepositKey2

# 2. 出金提现专用付款热钱包池
TRON_WITHDRAW_WALLET_KEYS=WithdrawKey1,WithdrawKey2

# 3. 发币专属部署钱包池 (TRC20 合约拥有者)
TRON_DEPLOYER_WALLET_KEYS=DeployerKey1
